{
  "name": "disha-habitat-v2-city",
  "version": "0.1.0",
  "private": true,
  "description": "Disha Habitat V2: A city, made of homes. An atlas of East Bengaluru drawn from OpenStreetMap.",
  "scripts": {
    "dev": "next dev -p 3300",
    "build": "next build",
    "start": "next start -p 3300",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "atlas:fetch": "sh scripts/fetch-osm.sh .osm-cache",
    "atlas:build": "python3 scripts/build-atlas.py .osm-cache ."
  },
  "dependencies": {
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "typescript": "^5"
  }
}
